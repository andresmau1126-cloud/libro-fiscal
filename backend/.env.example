# Database
DATABASE_URL=postgresql://user:password@localhost:5432/libro_fiscal

# Email Configuration (Brevo SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false

# IMPORTANT: use the Brevo SMTP login/password here, NOT the API key.
BREVO_SMTP_USER=tu_login_smtp_brevo
BREVO_SMTP_PASSWORD=tu_password_smtp_brevo
EMAIL_HOST_USER=tu_login_smtp_brevo
EMAIL_HOST_PASSWORD=tu_password_smtp_brevo
BREVO_SENDER_EMAIL=tu_email_verificado@dominio.com
BREVO_SENDER_NAME=Libro Fiscal
DEFAULT_FROM_EMAIL=tu_email_verificado@dominio.com
BREVO_API_KEY=tu_api_key_brevo

# Django
SECRET_KEY=tu_secret_key_aqui
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
